{
  "name": "veganalts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "build:staging": "CLOUDFLARE_ENV=staging react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/prepare.ts && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "tsx scripts/migrate.ts local",
    "db:migrate:staging": "tsx scripts/migrate.ts staging",
    "db:migrate:production": "tsx scripts/migrate.ts production",
    "auth:schema": "npx auth@1.7.7 generate --config ./db/auth-config.ts --output ./db/schema/auth.ts --yes",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy:staging": "npm run build:staging && wrangler deploy",
    "deploy:production": "npm run build:production && wrangler deploy",
    "postinstall": "wrangler types",
    "db:seed:local": "tsx scripts/seed.ts local",
    "db:seed:staging": "tsx scripts/seed.ts staging",
    "db:reset:local": "tsx scripts/reset-local.ts",
    "rankings:rebuild:local": "tsx scripts/rebuild-rankings.ts local",
    "rankings:rebuild:staging": "tsx scripts/rebuild-rankings.ts staging",
    "rankings:rebuild:production": "tsx scripts/rebuild-rankings.ts production",
    "db:seed-images:local": "tsx scripts/seed-images.ts local",
    "db:seed-images:staging": "tsx scripts/seed-images.ts staging",
    "moderation:calibrate": "tsx scripts/calibrate-clef.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/infra": "0.4.14",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "isbot": "5.1.36",
    "jose": "^6.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "0.31.11",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
