    "PUBLIC_LAUNCH": "false",
    "SUPPORT_CONTACT": "",
    "WEB_ANALYTICS_TOKEN": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veganalts-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
