{
  "include": [
    "app/**/*",
    "server/**/*",
    "workers/**/*",
    "db/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.ts",
    "worker-configuration.d.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "~/*": ["./app/*"], "@server/*": ["./server/*"] }
  }
}
