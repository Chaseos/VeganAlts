# Copy to .dev.vars for local Wrangler/Vite development. Never commit real values.
# Generate at least 32 random characters; use a different value per environment.
BETTER_AUTH_SECRET=

# Google OAuth web client, specific to this environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple website Services ID and signing key. Encode PEM newlines as \n.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional cloud dashboard integration; leave empty to disable it.
BETTER_AUTH_API_KEY=
